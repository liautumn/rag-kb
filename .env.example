# ===== 生成模型 =====
# 在线 OpenAI 兼容接口（magpie 代理）：
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_MODEL=workbuddy/deepseek-v4.1-flash
# 留空时自动复用环境变量 ANTHROPIC_AUTH_TOKEN
LLM_API_KEY=

# 本地 Ollama 生成模型（如需切回，注释上面四行并启用下面两行）：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3-vl:8b

# ===== 嵌入模型（本地 Ollama）=====
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

DOCS_DIR=./documents
CHROMA_DIR=./chroma_db
COLLECTION_NAME=rag_kb
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_K=4
LLM_TEMPERATURE=0.3
LLM_NUM_PREDICT=4096
LLM_NUM_CTX=8192
# 仅 ollama provider 使用；在线模型忽略此项
LLM_REASONING=true
REQUEST_TIMEOUT=300
